{
  "name": "gin-admin-react",
  "version": "3.0.0",
  "description": "RBAC权限管理脚手架",
  "private": true,
  "scripts": {
    "start": "umi dev",
    "start:no-mock": "cross-env MOCK=none umi dev",
    "analyze": "cross-env ANALYZE=1 umi build",
    "build": "umi build",
    "lint:style": "stylelint \"src/**/*.less\" --syntax less",
    "lint": "eslint --ext .js src && npm run lint:style",
    "lint:fix": "eslint --fix --ext .js src && npm run lint:style",
    "lint-staged": "lint-staged",
    "lint-staged:js": "eslint --ext .js"
  },
  "dependencies": {
    "@ant-design/compatible": "^1.0.2",
    "@ant-design/icons": "^5.2.6",
    "antd": "^4.24.13",
    "axios": "^1.6.7",
    "classnames": "^2.3.2",
    "history": "^5.3.0",
    "lodash": "^4.17.21",
    "lodash-decorators": "^6.0.1",
    "md5": "^2.3.0",
    "moment": "^2.29.4",
    "path-to-regexp": "^2.4.0",
    "prop-types": "^15.8.1",
    "qs": "^6.11.2",
    "react": "^18.2.0",
    "react-container-query": "^0.11.2",
    "react-document-title": "^2.0.3",
    "react-dom": "^18.2.0",
    "setprototypeof": "^1.2.0",
    "url-polyfill": "^1.1.12",
    "uuid": "^8.3.2",
    "yarn-check": "^0.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "babel-eslint": "^10.1.0",
    "cross-env": "^7.0.3",
    "cross-port-killer": "^1.3.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-babel": "^5.3.1",
    "eslint-plugin-compat": "^4.1.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.6.4",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-markdown": "^3.0.0",
    "eslint-plugin-react": "^7.33.2",
    "husky": "^8.0.3",
    "lint-staged": "^15.0.0",
    "prettier": "^3.1.0",
    "stylelint": "^15.10.3",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard": "^33.0.0",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0",
    "tslint-react": "^5.1.0",
    "umi": "^3",
    "@umijs/preset-react": "^1"
  },
  "lint-staged": {
    "**/*.{js,jsx,less}": [
      "prettier --write",
      "git add"
    ],
    "**/*.{js,jsx}": "npm run lint-staged:js",
    "**/*.less": "stylelint --syntax less"
  },
  "engines": {
    "node": ">=8.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint-staged"
    }
  }
}
